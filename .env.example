# Copy this file to .env before running docker compose up

# Postgres connection (matches docker-compose.yml service "db")
DATABASE_URL=postgresql+psycopg://tv9:tv9dev@db:5432/tv9_publisher

# App
ENVIRONMENT=local
LOG_LEVEL=INFO

# Platform credentials — fill these in during Phase 4 of the guide.
# Leave blank for now; adapters will raise a clear error if called without them.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

# Required — every API request must include this in an X-API-Key header.
# Generate a real random value for this, e.g. run in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
API_ACCESS_KEY=
